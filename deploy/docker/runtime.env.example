CRUNCHY_CALENDAR_IMAGE=ghcr.io/lukeaurio/crunchy-calendar:REPLACE_WITH_IMAGE_TAG
CRUNCHY_CALENDAR_SMTP_HOST=mail.example.com
CRUNCHY_CALENDAR_SMTP_PORT=587
CRUNCHY_CALENDAR_SMTP_SECURITY=starttls
CRUNCHY_CALENDAR_SMTP_USERNAME=calendar-bot@example.com
CRUNCHY_CALENDAR_SMTP_PASSWORD_FILE=/run/secrets/smtp-password
CRUNCHY_CALENDAR_SMTP_TIMEOUT_SECONDS=30
CRUNCHY_CALENDAR_MAIL_FROM=calendar-bot@example.com
CRUNCHY_CALENDAR_MAIL_TO=you@example.com,another-person@example.com
