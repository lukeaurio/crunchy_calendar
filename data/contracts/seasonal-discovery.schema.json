{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crunchy-calendar.local/contracts/seasonal-discovery.schema.json",
  "title": "Crunchy Calendar seasonal discovery report",
  "type": "object",
  "required": ["contract_version", "season", "show_count", "new_shows", "seen_shows"],
  "properties": {
    "contract_version": {"const": 1},
    "season": {"type": "string", "pattern": "^(spring|summer|fall|winter)-[0-9]{4}$"},
    "show_count": {"type": "integer", "minimum": 1},
    "new_shows": {
      "type": "array",
      "items": {"$ref": "#/$defs/show"}
    },
    "seen_shows": {
      "type": "array",
      "items": {"$ref": "#/$defs/show"}
    }
  },
  "$defs": {
    "show": {
      "type": "object",
      "required": ["show_key", "title", "url", "season", "seen_before"],
      "properties": {
        "show_key": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri", "pattern": "^https://www\\.crunchyroll\\.com/series/"},
        "season": {"type": "string", "pattern": "^(spring|summer|fall|winter)-[0-9]{4}$"},
        "first_seen": {"type": "string", "format": "date-time"},
        "last_seen": {"type": "string", "format": "date-time"},
        "seen_before": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
