{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crunchy-calendar.local/contracts/languages.schema.json",
  "title": "Crunchy Calendar language configuration",
  "type": "object",
  "required": ["enabled", "patterns"],
  "properties": {
    "$schema": {"type": "string"},
    "enabled": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "patterns": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      }
    }
  },
  "additionalProperties": false
}
