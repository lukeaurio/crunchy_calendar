{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crunchy-calendar.local/contracts/discovery-state.schema.json",
  "title": "Crunchy Calendar discovery ledger",
  "type": "object",
  "required": ["contract_version", "shows"],
  "properties": {
    "contract_version": {"const": 1},
    "shows": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {"$ref": "#/$defs/seasonalShow"},
          {"$ref": "#/$defs/rollingShow"}
        ]
      }
    }
  },
  "$defs": {
    "seasonalShow": {
      "type": "object",
      "required": ["show_key", "title", "url", "season"],
      "properties": {
        "show_key": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri", "pattern": "^https://www\\.crunchyroll\\.com/series/"},
        "season": {"type": "string", "pattern": "^(spring|summer|fall|winter)-[0-9]{4}$"},
        "first_seen": {"type": "string", "format": "date-time"},
        "last_seen": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "rollingShow": {
      "type": "object",
      "required": ["title", "release_count", "first_seen", "last_seen", "languages"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "release_count": {"type": "integer", "minimum": 1},
        "first_seen": {"type": "string", "format": "date"},
        "last_seen": {"type": "string", "format": "date"},
        "languages": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
